{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9098,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8085,
      "host": "0.0.0.0"
    },
    "storage": {
      "port": 9198,
      "host": "0.0.0.0"
    },
    "functions": {
      "port": 5011,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 4010,
      "host": "0.0.0.0"
    },
    "hub": {
      "port": 4400
    },
    "logging": {
      "port": 4500
    },
    "eventarc": {
      "port": 9150
    },
    "singleProjectMode": true,
    "hosting": {
      "port": 5002,
      "host": "0.0.0.0"
    }
  },
  "hosting": {
    "public": "web",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}