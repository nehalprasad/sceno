# Copy to .env and fill from Firebase console > Project settings > Your apps > Web app.
# These are public client identifiers, not secrets. Leave empty to run on mock data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps venue search (Places API). Google Cloud > APIs > enable "Places API" > Credentials > API key.
# Restrict it to the iOS/Android app. Leave empty and the venue field is plain text.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
