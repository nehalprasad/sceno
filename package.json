  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "emulators": "npm --prefix functions run build && PATH=/opt/homebrew/opt/openjdk@21/bin:$PATH firebase emulators:start --project demo-sceno --import .emulator-data --export-on-exit .emulator-data",
    "seed": "GCLOUD_PROJECT=demo-sceno node scripts/seed.mjs",
    "start:emu": "EXPO_PUBLIC_USE_EMULATOR=1 EXPO_PUBLIC_FIREBASE_API_KEY=demo-key EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-sceno EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-sceno.appspot.com EXPO_PUBLIC_FIREBASE_APP_ID=demo expo start",
    "start:emu:demo": "EXPO_PUBLIC_USE_EMULATOR=1 EXPO_PUBLIC_FIREBASE_API_KEY=demo-key EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-sceno EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-sceno.appspot.com EXPO_PUBLIC_FIREBASE_APP_ID=demo EXPO_PUBLIC_DEMO_NOW=2026-12-13T11:00:00 expo start",
    "deploy": "firebase deploy --only firestore,storage,functions",
    "test:backend": "node scripts/backend-test.mjs",
    "lint": "expo lint"
  },
  "private": true
}
